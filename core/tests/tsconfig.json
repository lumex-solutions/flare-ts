{
  // Node-pool test files. Mirrors vitest.config.ts: Cloudflare tests are typed by
  // tests/cloudflare/tsconfig.json (workers-types) instead, so they're excluded here to keep DOM
  // globals (e.g. Headers.getSetCookie) that @cloudflare/workers-types would otherwise shadow.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": ["**/*.ts"],
  "exclude": ["cloudflare/**"]
}
