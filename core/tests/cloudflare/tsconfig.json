{
  // Cloudflare-pool test files. Mirrors vitest.config.cloudflare.ts (workerd). Adds
  // @cloudflare/workers-types so runtime globals (DurableObjectState, ExecutionContext,
  // Cloudflare.Env, the `cloudflare:workers` module) resolve here.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals", "@cloudflare/workers-types"]
  },
  "include": ["**/*.ts"]
}
