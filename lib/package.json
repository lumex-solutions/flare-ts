{
  "name": "@flare-ts/lib",
  "version": "0.3.0-next.8",
  "description": "Schema primitives and standard library for Flare, with zero runtime dependencies.",
  "license": "MIT",
  "author": "Lumex Solutions",
  "homepage": "https://github.com/lumex-solutions/flare-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumex-solutions/flare-ts.git",
    "directory": "lib"
  },
  "bugs": {
    "url": "https://github.com/lumex-solutions/flare-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && esbuild \"src/**/*.ts\" --format=esm --outdir=dist --platform=neutral --target=es2022 && tsc -p tsconfig.build.json",
    "build:watch": "esbuild \"src/**/*.ts\" --format=esm --outdir=dist --platform=neutral --target=es2022 --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.11.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.9"
  }
}
